{"$id":"https://scientific-resource-lab/schemas/automation/state/v1.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"AutomationState/v1: persisted runtime state for an autonomous mission.","properties":{"checkpoints":{"description":"Append-only array of receipt references recording mission progress.","items":{"additionalProperties":false,"properties":{"receipt_ref":{"type":"string"},"recorded_utc":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$","type":"string"},"wp_id":{"type":"string"}},"required":["wp_id","receipt_ref","recorded_utc"],"type":"object"},"type":"array","uniqueItems":true},"current_wp":{"type":"string"},"lanes":{"description":"Active implementation lanes; bounded by the policy (max 4).","items":{"additionalProperties":false,"properties":{"lane_id":{"type":"string"},"wp_id":{"type":"string"}},"required":["lane_id","wp_id"],"type":"object"},"maxItems":4,"type":"array","uniqueItems":true},"mission_digest":{"description":"SHA-256 hex digest of the mission manifest; the identity anchor for resume.","pattern":"^[0-9a-f]{64}$","type":"string"},"scientific_wip":{"description":"In-flight scientific executions; bounded by the policy (max 1).","items":{"additionalProperties":false,"properties":{"started_utc":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$","type":"string"},"wp_id":{"type":"string"}},"required":["wp_id","started_utc"],"type":"object"},"maxItems":1,"type":"array","uniqueItems":true},"terminal_status":{"description":"Lifecycle status of the automation run.","enum":["RUNNING","WAIT_ENVIRONMENT","WAIT_RESOURCE","WAIT_LICENSE","WAIT_PLATFORM","WAIT_SCHEMA","WAIT_CAPABILITY","WAIT_REMOTE_EXECUTOR","WAIT_CONTRACT_UPDATE","WAIT_RUNTIME_HEALTH","WAIT_AUTHORITY","PARKED","STOP_INTEGRITY","STOP_PRIVACY","STOP_SECURITY","STOP_NONCONVERGENT","COMPLETED"],"type":"string"}},"required":["mission_digest","current_wp","terminal_status"],"schema_version":"AutomationStateSchema/v1","title":"AutomationState/v1","type":"object"}
