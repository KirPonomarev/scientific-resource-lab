{"$id":"https://scientific-resource-lab/schemas/automation/state/v1.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"AutomationState/v1: persisted runtime state for an autonomous mission.","properties":{"active_lanes":{"description":"Active implementation lanes recorded in the lane ledger (ActiveLaneLedger/v1). Each entry mirrors the lane-entry shape; bounded by the policy cap (max 6). Optional: an AutomationState without this field still validates.","items":{"additionalProperties":false,"properties":{"base_sha":{"type":"string"},"branch":{"type":"string"},"executor":{"enum":["glm-5.2","kimi-for-coding","orchestrator"],"type":"string"},"lane_id":{"type":"string"},"lease":{"additionalProperties":false,"properties":{"acquired_utc":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$","type":"string"},"heartbeat_utc":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$","type":"string"},"ttl_seconds":{"minimum":1,"type":"integer"}},"required":["acquired_utc","heartbeat_utc","ttl_seconds"],"type":"object"},"owned_paths":{"items":{"type":"string"},"type":"array","uniqueItems":true},"status":{"enum":["active","parked","completed","stopped"],"type":"string"},"worktree_fingerprint":{"pattern":"^[0-9a-f]{64}$","type":"string"},"wp_id":{"type":"string"}},"required":["lane_id","wp_id","executor","worktree_fingerprint","branch","base_sha","owned_paths","lease","status"],"type":"object"},"maxItems":6,"type":"array","uniqueItems":true},"checkpoints":{"description":"Append-only array of receipt references recording mission progress.","items":{"additionalProperties":false,"properties":{"receipt_ref":{"type":"string"},"recorded_utc":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$","type":"string"},"wp_id":{"type":"string"}},"required":["wp_id","receipt_ref","recorded_utc"],"type":"object"},"type":"array","uniqueItems":true},"current_wp":{"type":"string"},"lanes":{"description":"Active implementation lanes; bounded by the policy (max 4).","items":{"additionalProperties":false,"properties":{"lane_id":{"type":"string"},"wp_id":{"type":"string"}},"required":["lane_id","wp_id"],"type":"object"},"maxItems":4,"type":"array","uniqueItems":true},"max_lanes":{"const":6,"description":"Machine-enforced upper bound on active implementation lanes; MUST equal policy max_parallel_implementation_lanes. The gov-lanes-gate (GOV-01) proves this const matches the policy cap.","type":"integer"},"mission_digest":{"description":"SHA-256 hex digest of the mission manifest; the identity anchor for resume.","pattern":"^[0-9a-f]{64}$","type":"string"},"scientific_wip":{"description":"In-flight scientific executions; bounded by the policy (max 1).","items":{"additionalProperties":false,"properties":{"started_utc":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$","type":"string"},"wp_id":{"type":"string"}},"required":["wp_id","started_utc"],"type":"object"},"maxItems":1,"type":"array","uniqueItems":true},"terminal_status":{"description":"Lifecycle status of the automation run.","enum":["RUNNING","WAIT_ENVIRONMENT","WAIT_RESOURCE","WAIT_LICENSE","WAIT_PLATFORM","WAIT_SCHEMA","WAIT_CAPABILITY","WAIT_REMOTE_EXECUTOR","WAIT_CONTRACT_UPDATE","WAIT_RUNTIME_HEALTH","WAIT_AUTHORITY","PARKED","STOP_INTEGRITY","STOP_PRIVACY","STOP_SECURITY","STOP_NONCONVERGENT","COMPLETED"],"type":"string"}},"required":["mission_digest","current_wp","terminal_status"],"schema_version":"AutomationStateSchema/v1","title":"AutomationState/v1","type":"object"}
