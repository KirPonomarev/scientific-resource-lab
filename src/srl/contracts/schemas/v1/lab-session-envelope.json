{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.srlab.dev/v1/LabSessionEnvelope.json",
  "title": "LabSessionEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "cell_id", "project_fingerprint", "created_utc", "classification", "canonical_writes", "grants_authority"],
  "properties": {
    "schema_version": {"type": "string", "const": "LabSessionEnvelope/v1"},
    "session_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cell_id": {"type": "string", "minLength": 1},
    "project_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_utc": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "classification": {"type": "string", "enum": ["D0", "D1"]},
    "canonical_writes": {"type": "integer", "const": 0},
    "grants_authority": {"type": "boolean", "const": false}
  }
}
