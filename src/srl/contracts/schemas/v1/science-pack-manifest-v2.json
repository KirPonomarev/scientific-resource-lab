{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.srlab.dev/v1/SciencePackManifestV2.json",
  "title": "SciencePackManifest/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "version", "licenses", "sources", "resource_envelope", "canonical_writes", "grants_authority"],
  "properties": {
    "schema_version": {"type": "string", "const": "SciencePackManifest/v2"},
    "pack_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "licenses": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "resource_envelope": {"type": "object"},
    "canonical_writes": {"type": "integer", "const": 0},
    "grants_authority": {"type": "boolean", "const": false}
  }
}
