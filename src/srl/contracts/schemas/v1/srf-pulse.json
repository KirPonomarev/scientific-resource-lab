{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.srlab.dev/v1/SRFPulse.json",
  "title": "SRFPulse/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pulse_id", "status", "observed_utc", "head_sha", "canonical_writes", "grants_authority"],
  "properties": {
    "schema_version": {"type": "string", "const": "SRFPulse/v1"},
    "pulse_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"type": "string", "enum": ["GREEN", "YELLOW", "RED", "WAIT"]},
    "observed_utc": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "canonical_writes": {"type": "integer", "const": 0},
    "grants_authority": {"type": "boolean", "const": false}
  }
}
